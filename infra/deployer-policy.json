{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AgentCoreControlAndData",
      "Effect": "Allow",
      "Action": "bedrock-agentcore:*",
      "Resource": "*",
      "Condition": {"StringEquals": {"aws:RequestedRegion": "ap-southeast-2"}}
    },
    {
      "Sid": "BedrockModelsInRegion",
      "Effect": "Allow",
      "Action": [
        "bedrock:ListFoundationModels",
        "bedrock:GetFoundationModel",
        "bedrock:ListInferenceProfiles",
        "bedrock:GetInferenceProfile",
        "bedrock:InvokeModel",
        "bedrock:InvokeModelWithResponseStream",
        "bedrock:Converse",
        "bedrock:ConverseStream"
      ],
      "Resource": [
        "arn:aws:bedrock:ap-southeast-2:*:inference-profile/au.*",
        "arn:aws:bedrock:*::foundation-model/*"
      ]
    },
    {
      "Sid": "CreateAndPassTheRuntimeExecutionRole",
      "Effect": "Allow",
      "Action": [
        "iam:CreateRole",
        "iam:GetRole",
        "iam:TagRole",
        "iam:PutRolePolicy",
        "iam:GetRolePolicy",
        "iam:AttachRolePolicy",
        "iam:ListAttachedRolePolicies",
        "iam:CreateServiceLinkedRole"
      ],
      "Resource": "arn:aws:iam::*:role/mise-*"
    },
    {
      "Sid": "PassOnlyToAgentCore",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "arn:aws:iam::*:role/mise-*",
      "Condition": {
        "StringEquals": {"iam:PassedToService": "bedrock-agentcore.amazonaws.com"}
      }
    }
  ]
}
