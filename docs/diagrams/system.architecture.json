  "cards": [
    {
      "dot": "cyan",
      "title": "The Load-Bearing Split",
      "items": [
        "Alexa+ budgets ~500 ms per tool round-trip",
        "A vision model never fits in that budget",
        "So the agent writes a cache and tools only read it"
      ]
    },
    {
      "dot": "rose",
      "title": "Refusal Is Enforced, Not Prompted",
      "items": [
        "gate.py returns refuse on stale frames or low confidence",
        "Dogwood conditions on the agent's own action history",
        "Strands steering cancels advance_step at the tool boundary"
      ]
    },
    {
      "dot": "emerald",
      "title": "Documented AWS Integrations",
      "items": [
        "Runtime hosts both the MCP server and the agent graph",
        "Memory calibrates per cook and per hob",
        "Observability traces every graph node; Evaluations scores abstention"
      ]
    }
  ]
