  "cards": [
    {
      "dot": "cyan",
      "title": "Why These Are Separate Agents",
      "items": [
        "Risk must never be gated on the perception agent's confidence",
        "The critic runs only where a mistake is expensive, so cost stays flat",
        "Calibration and choreography plan; they must not run at frame rate"
      ]
    },
    {
      "dot": "rose",
      "title": "The Arbiter Is Deliberately Dumb",
      "items": [
        "Three agent opinions converge on one deterministic merge",
        "Only the arbiter writes, so the cache has a single author",
        "The merge is unit-testable with no model in the loop"
      ]
    },
    {
      "dot": "emerald",
      "title": "Honest Accounting",
      "items": [
        "The critic is the node that earns the multi-agent claim",
        "Calibration could be a function today \u2014 it becomes an agent when it reasons over history",
        "Choreography is the only node that genuinely plans"
      ]
    }
  ]
